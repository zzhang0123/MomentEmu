    given-names: Zheng
    email: zheng_zhang1@alumni.brown.edu
license: MIT
repository-code: "https://github.com/zzhang0123/MomentEmu"
keywords:
  - emulator
  - polynomial
  - cosmology
  - scientific-computing
  - autodiff
